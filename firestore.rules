rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == uid || request.auth.token.email == 'maxlee4329@gmail.com');
    }

    match /claimedPlayers/{playerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && !exists(/databases/$(database)/documents/claimedPlayers/$(playerId));
      allow update, delete: if false; 
    }

    match /customBios/{playerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /tokenLedger/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /fanPolls/{pollId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /parlays/{parlayId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    match /seasons/{seasonId}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
